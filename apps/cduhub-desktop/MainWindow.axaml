<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Cduhub.DesktopGui.Controls"
        xmlns:cduhub="clr-namespace:Cduhub.DesktopGui"
        x:Class="Cduhub.DesktopGui.MainWindow"
        mc:Ignorable="d"
        Width="640" Height="720"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowState="Minimized"
        Icon="/Assets/app.ico"
        Title="CDU Hub">

    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4" Spacing="6">
            <TextBlock Text="USB device:" VerticalAlignment="Center" />
            <TextBlock x:Name="_Label_UsbDeviceState"
                       Text="-"
                       VerticalAlignment="Center"
                       FontFamily="{x:Static cduhub:Fonts.MonospacedStack}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,8" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Configs:" VerticalAlignment="Center" />
                <HyperlinkButton x:Name="_Link_ConfigFolder"
                                 Content="-"
                                 Padding="0"
                                 Click="ConfigFolder_Click" />
            </StackPanel>
            <HyperlinkButton x:Name="_Link_About"
                             Content="About"
                             HorizontalAlignment="Center"
                             Click="About_Click" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,4" Spacing="2">
            <TextBlock Text="Flight Simulators" FontWeight="SemiBold" />
            <DataGrid x:Name="_Grid_FlightSims"
                      x:DataType="cduhub:FlightSimRow"
                      MaxHeight="150"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      GridLinesVisibility="All"
                      HeadersVisibility="Column"
                      FontFamily="{x:Static cduhub:Fonts.MonospacedStack}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Flight Simulator" Width="Auto" Binding="{Binding FlightSimulatorName}" />
                    <DataGridTextColumn Header="Aircraft" Width="Auto" Binding="{Binding AircraftName}" />
                    <DataGridTextColumn Header="State" Width="Auto" Binding="{Binding ConnectionState}" />
                    <DataGridTextColumn Header="Last Message" Width="Auto" Binding="{Binding LastMessage}" />
                    <DataGridTemplateColumn Header="Messages" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="cduhub:FlightSimRow">
                                <TextBlock Text="{Binding CountMessages}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="12,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <Border Background="Black" BorderBrush="Black" BorderThickness="2">
            <controls:CduDisplayControl x:Name="_CduDisplay" />
        </Border>

    </DockPanel>

</Window>
